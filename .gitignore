# --- Archivos de entorno ---
.env
.env.local

# --- Entornos virtuales ---
venv/
env/

# --- Archivos de compilación de Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
*.so

# --- Archivos temporales ---
*.log
*.pot

# --- Archivos de configuración de IDEs ---
.idea/
.vscode/
*.swp
*.swo

# --- Archivos del sistema ---
.DS_Store
Thumbs.db

# --- Archivos específicos del proyecto que NO deben subirse ---
clinica_veterinaria/settings.py
clinica_veterinaria/urls.py

# --- Archivos de migraciones ---
*/migrations/*
!*/migrations/__init__.py

# --- Archivos de base de datos locales ---
db.sqlite3


